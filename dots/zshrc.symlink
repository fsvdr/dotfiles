###############################################################################
# ZSH CONFIGURATION                                                          #
###############################################################################
# This is it folks, welcome to dotland (zsh edition)

# Path to Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"

# Symlink custom theme into Oh My Zsh if not already there
[[ ! -f "$ZSH/custom/themes/fsvdr.zsh-theme" ]] && \
  ln -sf "$HOME/.dotfiles/dots/fsvdr.zsh-theme" "$ZSH/custom/themes/fsvdr.zsh-theme"

# Theme
ZSH_THEME="fsvdr"

# Plugins
plugins=(git npm zsh-autosuggestions zsh-syntax-highlighting)

# Load Oh My Zsh
source $ZSH/oh-my-zsh.sh

# --- Source shared configs ---
[[ -f "$HOME/.aliases" ]]   && source "$HOME/.aliases"
[[ -f "$HOME/.functions" ]] && source "$HOME/.functions"
[[ -f "$HOME/.path" ]]      && source "$HOME/.path"

# --- Tool initialization ---

# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# pnpm — PNPM_HOME holds globally-installed pnpm packages; pnpm itself comes
# from mise (activated last so its shims sit at the front of PATH).
export PNPM_HOME="$HOME/Library/pnpm"
export PATH="$PNPM_HOME:$PATH"
type pnpm &>/dev/null && source <(pnpm completion zsh)

# mise — must come AFTER any PATH-prepending tool setup so its shims win.
type mise &>/dev/null && eval "$(mise activate zsh)"

# PATH deduplication (zsh-native)
typeset -U PATH
